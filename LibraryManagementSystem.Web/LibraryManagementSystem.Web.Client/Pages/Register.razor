@page "/register"
@inject LibraryManagementSystem.Web.Client.Services.AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Register - LMS</PageTitle>

<div class="auth-container">
    <div class="auth-card glass-panel fade-in-up">
        <div class="auth-header">
            <h2>Create an Account</h2>
            <p>Join the Library Management System</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        <EditForm Model="@registerModel" OnValidSubmit="HandleRegister" class="auth-form">
            <DataAnnotationsValidator />
            
            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="firstName">First Name</label>
                    <InputText id="firstName" class="form-control premium-input" @bind-Value="registerModel.FirstName" />
                    <ValidationMessage For="@(() => registerModel.FirstName)" />
                </div>
                <div class="col-md-6 form-group">
                    <label for="lastName">Last Name</label>
                    <InputText id="lastName" class="form-control premium-input" @bind-Value="registerModel.LastName" />
                    <ValidationMessage For="@(() => registerModel.LastName)" />
                </div>
            </div>

            <div class="form-group mt-3">
                <label for="email">Email</label>
                <InputText id="email" class="form-control premium-input" @bind-Value="registerModel.Email" />
                <ValidationMessage For="@(() => registerModel.Email)" />
            </div>

            <div class="form-group mt-3">
                <label for="password">Password</label>
                <InputText type="password" id="password" class="form-control premium-input" @bind-Value="registerModel.Password" />
                <ValidationMessage For="@(() => registerModel.Password)" />
            </div>
            
            <div class="form-group mt-3">
                <label for="role" class="form-label">Role</label>
                <select id="role" class="form-select premium-input" @bind="registerModel.Role">
                    <option value="2">Member</option>
                    <option value="1">Librarian</option>
                    <option value="0">Admin</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary premium-btn mt-4 w-100" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> Registering...</span>
                }
                else
                {
                    <span>Register</span>
                }
            </button>
        </EditForm>
        <div class="auth-footer mt-4 text-center">
            <p>Already have an account? <a href="/login" class="premium-link">Login here</a></p>
        </div>
    </div>
</div>

@code {
    private RegisterModel registerModel = new();
    private bool isLoading;
    private string? errorMessage;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;
        
        var success = await AuthService.RegisterAsync(
            registerModel.Email, 
            registerModel.Password, 
            registerModel.FirstName, 
            registerModel.LastName, 
            registerModel.Role);

        if (success)
        {
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            errorMessage = "Registration failed. Please try again.";
        }
        isLoading = false;
    }

    public class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string FirstName { get; set; } = string.Empty;
        
        [System.ComponentModel.DataAnnotations.Required]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(6)]
        public string Password { get; set; } = string.Empty;
        
        public int Role { get; set; } = 2; // Default to Member
    }
}
