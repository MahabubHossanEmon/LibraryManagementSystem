@page "/members"
@inject HttpClient Http
@using System.Net.Http.Json

<PageTitle>Members & Users - LMS</PageTitle>

<div class="container fade-in-up py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="mb-1"><i class="bi bi-people me-2 text-info"></i>Library Members & Users</h2>
            <p class="text-secondary mb-0">View system users, track member borrowing history, and update access roles.</p>
        </div>
    </div>

    @if (alertMessage != null)
    {
        <div class="alert @(isErrorAlert ? "alert-danger" : "alert-success") glass-panel alert-dismissible fade show mb-4" role="alert">
            @alertMessage
            <button type="button" class="btn-close btn-close-white" @onclick="() => alertMessage = null"></button>
        </div>
    }

    <!-- Search Bar -->
    <div class="card glass-panel p-3 mb-4">
        <div class="input-group">
            <span class="input-group-text bg-dark text-white border-secondary"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Search members by name or email..." @bind="searchQuery" @bind:event="oninput" />
        </div>
    </div>

    @if (users == null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!FilteredUsers.Any())
    {
        <div class="alert alert-info glass-panel text-center py-4">
            <i class="bi bi-info-circle display-6 d-block mb-2 text-info"></i>
            No members found matching your search.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var user in FilteredUsers)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card premium-card glass-panel h-100 d-flex flex-column justify-content-between">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title text-white fw-bold mb-0">@user.FullName</h5>
                                <span class="badge @GetRoleBadgeClass(user.Role)">@user.Role</span>
                            </div>
                            <p class="card-text text-secondary mb-3">
                                <i class="bi bi-envelope me-2 text-info"></i>@user.Email
                            </p>
                            <div class="pt-2 border-top border-secondary d-flex justify-content-between align-items-center">
                                <small class="text-secondary">Active Borrows:</small>
                                <span class="badge bg-primary">@user.ActiveBorrowsCount books</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-top border-secondary text-end py-3">
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => OpenRoleModal(user)">
                                <i class="bi bi-shield-lock me-1"></i> Edit Role
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Edit Role Modal -->
@if (showRoleModal && selectedUser != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content glass-panel text-white">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title"><i class="bi bi-shield-check me-2"></i>Update Role</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRoleModal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2 small text-secondary">Member: <strong>@selectedUser.FullName</strong></p>
                    <label class="form-label fw-bold">Select Role</label>
                    <select class="form-select bg-dark text-white border-secondary" @bind="newRoleInt">
                        <option value="0">Member</option>
                        <option value="1">Librarian</option>
                        <option value="2">Admin</option>
                    </select>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" @onclick="CloseRoleModal">Cancel</button>
                    <button type="button" class="btn btn-primary premium-btn" @onclick="SaveRole">Save Role</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto>? users;
    private string searchQuery = string.Empty;

    private bool showRoleModal = false;
    private UserDto? selectedUser;
    private int newRoleInt = 0;

    private string? alertMessage;
    private bool isErrorAlert = false;

    private IEnumerable<UserDto> FilteredUsers
    {
        get
        {
            if (users == null) return Enumerable.Empty<UserDto>();
            if (string.IsNullOrWhiteSpace(searchQuery)) return users;

            var q = searchQuery.Trim().ToLower();
            return users.Where(u => u.FullName.ToLower().Contains(q) || u.Email.ToLower().Contains(q));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            users = await Http.GetFromJsonAsync<List<UserDto>>("api/users");
        }
        catch (Exception ex)
        {
            SetAlert($"Failed to load members: {ex.Message}", true);
            users = new List<UserDto>();
        }
    }

    private void OpenRoleModal(UserDto user)
    {
        selectedUser = user;
        newRoleInt = user.Role switch
        {
            "Librarian" => 1,
            "Admin" => 2,
            _ => 0
        };
        showRoleModal = true;
    }

    private void CloseRoleModal()
    {
        showRoleModal = false;
        selectedUser = null;
    }

    private async Task SaveRole()
    {
        if (selectedUser == null) return;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/users/{selectedUser.Id}/role", newRoleInt);
            if (response.IsSuccessStatusCode)
            {
                SetAlert("Member role updated successfully!", false);
                CloseRoleModal();
                await LoadUsers();
            }
            else
            {
                SetAlert("Failed to update role.", true);
            }
        }
        catch (Exception ex)
        {
            SetAlert($"Error updating role: {ex.Message}", true);
        }
    }

    private string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "Admin" => "bg-danger",
            "Librarian" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    private void SetAlert(string message, bool isError)
    {
        alertMessage = message;
        isErrorAlert = isError;
    }

    public class UserDto
    {
        public Guid Id { get; set; }
        public string Email { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string FullName => $"{FirstName} {LastName}".Trim();
        public string Role { get; set; } = string.Empty;
        public int ActiveBorrowsCount { get; set; }
    }
}
