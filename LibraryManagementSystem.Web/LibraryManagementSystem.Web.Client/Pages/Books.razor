@page "/books"
@inject HttpClient Http
@using System.Net.Http.Json

<PageTitle>Books Catalog - LMS</PageTitle>

<div class="container fade-in-up py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="mb-1"><i class="bi bi-book me-2 text-primary"></i>Books Catalog</h2>
            <p class="text-secondary mb-0">Browse, search, add, edit, or reserve books in the collection.</p>
        </div>
        <div>
            <button class="btn btn-primary premium-btn" @onclick="OpenCreateModal">
                <i class="bi bi-plus-lg me-1"></i> Add New Book
            </button>
        </div>
    </div>

    @if (alertMessage != null)
    {
        <div class="alert @(isErrorAlert ? "alert-danger" : "alert-success") glass-panel alert-dismissible fade show mb-4" role="alert">
            @alertMessage
            <button type="button" class="btn-close btn-close-white" @onclick="() => alertMessage = null"></button>
        </div>
    }

    <!-- Search & Filter Controls -->
    <div class="card glass-panel p-3 mb-4">
        <div class="row g-3">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-dark text-white border-secondary"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-dark text-white border-secondary" placeholder="Search by title, author, or ISBN..." @bind="searchQuery" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-md-5">
                <select class="form-select bg-dark text-white border-secondary" @bind="selectedBranchFilter">
                    <option value="">All Branches</option>
                    @if (branches != null)
                    {
                        @foreach (var b in branches)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    @if (books == null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!FilteredBooks.Any())
    {
        <div class="alert alert-info glass-panel text-center py-4">
            <i class="bi bi-info-circle display-6 d-block mb-2 text-info"></i>
            No books found matching your search parameters.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var book in FilteredBooks)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card premium-card glass-panel h-100 d-flex flex-column justify-content-between">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title text-truncate fw-bold mb-0" title="@book.Title">@book.Title</h5>
                                <span class="badge bg-secondary ms-2">@book.BranchName</span>
                            </div>
                            <h6 class="card-subtitle mb-3 text-secondary">By @book.Author</h6>
                            
                            <div class="mb-3">
                                <span class="badge bg-primary">Year: @book.YearPublished</span>
                                <span class="badge bg-info text-dark ms-1">ISBN: @book.ISBN</span>
                            </div>
                            
                            <p class="card-text mb-2"><small class="text-secondary">Publisher: @book.Publisher</small></p>
                            
                            <div class="pt-2 border-top border-secondary d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="@(book.AvailableCopies > 0 ? "text-success" : "text-danger") fw-bold">@book.AvailableCopies</span>
                                    <span class="text-secondary small">/ @book.TotalCopies available</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-top border-secondary d-flex justify-content-between align-items-center py-3">
                            <div>
                                <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => OpenEditModal(book)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => OpenDeleteModal(book)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <button class="btn btn-sm btn-outline-light premium-btn" @onclick="() => ReserveBook(book.Id)" disabled="@(book.AvailableCopies <= 0)">
                                <i class="bi bi-bookmark-plus me-1"></i> Reserve
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Create / Edit Book Modal -->
@if (showBookModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-panel text-white">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">
                        <i class="bi @(isEditMode ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
                        @(isEditMode ? "Edit Book" : "Add New Book")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseBookModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Title</label>
                        <input type="text" class="form-control bg-dark text-white border-secondary" @bind="bookForm.Title" placeholder="e.g. The Great Gatsby" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Author</label>
                        <input type="text" class="form-control bg-dark text-white border-secondary" @bind="bookForm.Author" placeholder="e.g. F. Scott Fitzgerald" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">ISBN</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="bookForm.ISBN" placeholder="978-3-16-148410-0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Year Published</label>
                            <input type="number" class="form-control bg-dark text-white border-secondary" @bind="bookForm.YearPublished" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Publisher</label>
                        <input type="text" class="form-control bg-dark text-white border-secondary" @bind="bookForm.Publisher" placeholder="e.g. Scribner" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Total Copies</label>
                            <input type="number" class="form-control bg-dark text-white border-secondary" @bind="bookForm.TotalCopies" min="1" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Branch</label>
                            <select class="form-select bg-dark text-white border-secondary" @bind="bookForm.BranchId">
                                <option value="@Guid.Empty">-- Select Branch --</option>
                                @if (branches != null)
                                {
                                    @foreach (var b in branches)
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" @onclick="CloseBookModal">Cancel</button>
                    <button type="button" class="btn btn-primary premium-btn" @onclick="SaveBook" disabled="@(string.IsNullOrWhiteSpace(bookForm.Title) || bookForm.BranchId == Guid.Empty)">
                        Save Book
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && selectedBookForDelete != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.7);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content glass-panel text-white">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Book</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@selectedBookForDelete.Title</strong>?</p>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BookDto>? books;
    private List<BranchDto>? branches;
    private string searchQuery = string.Empty;
    private string selectedBranchFilter = string.Empty;

    private bool showBookModal = false;
    private bool isEditMode = false;
    private BookFormModel bookForm = new();

    private bool showDeleteModal = false;
    private BookDto? selectedBookForDelete;

    private string? alertMessage;
    private bool isErrorAlert = false;

    private IEnumerable<BookDto> FilteredBooks
    {
        get
        {
            if (books == null) return Enumerable.Empty<BookDto>();

            var result = books.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var q = searchQuery.Trim().ToLower();
                result = result.Where(b => b.Title.ToLower().Contains(q) || b.Author.ToLower().Contains(q) || b.ISBN.ToLower().Contains(q));
            }

            if (!string.IsNullOrWhiteSpace(selectedBranchFilter) && Guid.TryParse(selectedBranchFilter, out var branchId))
            {
                result = result.Where(b => b.BranchId == branchId);
            }

            return result;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBooks();
        await LoadBranches();
    }

    private async Task LoadBooks()
    {
        try
        {
            books = await Http.GetFromJsonAsync<List<BookDto>>("api/books");
        }
        catch (Exception ex)
        {
            SetAlert($"Error loading books: {ex.Message}", true);
        }
    }

    private async Task LoadBranches()
    {
        try
        {
            branches = await Http.GetFromJsonAsync<List<BranchDto>>("api/branches");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading branches: {ex.Message}");
        }
    }

    private void OpenCreateModal()
    {
        isEditMode = false;
        bookForm = new BookFormModel
        {
            YearPublished = DateTime.Now.Year,
            TotalCopies = 1,
            BranchId = branches?.FirstOrDefault()?.Id ?? Guid.Empty
        };
        showBookModal = true;
    }

    private void OpenEditModal(BookDto book)
    {
        isEditMode = true;
        bookForm = new BookFormModel
        {
            Id = book.Id,
            Title = book.Title,
            Author = book.Author,
            ISBN = book.ISBN,
            Publisher = book.Publisher,
            YearPublished = book.YearPublished,
            TotalCopies = book.TotalCopies,
            BranchId = book.BranchId
        };
        showBookModal = true;
    }

    private void CloseBookModal()
    {
        showBookModal = false;
    }

    private async Task SaveBook()
    {
        try
        {
            if (isEditMode)
            {
                var response = await Http.PutAsJsonAsync($"api/books/{bookForm.Id}", bookForm);
                if (response.IsSuccessStatusCode)
                {
                    SetAlert("Book updated successfully!", false);
                    showBookModal = false;
                    await LoadBooks();
                }
                else
                {
                    SetAlert("Failed to update book.", true);
                }
            }
            else
            {
                var response = await Http.PostAsJsonAsync("api/books", bookForm);
                if (response.IsSuccessStatusCode)
                {
                    SetAlert("Book added successfully!", false);
                    showBookModal = false;
                    await LoadBooks();
                }
                else
                {
                    SetAlert("Failed to add book.", true);
                }
            }
        }
        catch (Exception ex)
        {
            SetAlert($"Error saving book: {ex.Message}", true);
        }
    }

    private void OpenDeleteModal(BookDto book)
    {
        selectedBookForDelete = book;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        selectedBookForDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (selectedBookForDelete == null) return;
        try
        {
            var response = await Http.DeleteAsync($"api/books/{selectedBookForDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                SetAlert("Book deleted successfully!", false);
                CloseDeleteModal();
                await LoadBooks();
            }
            else
            {
                SetAlert("Failed to delete book.", true);
            }
        }
        catch (Exception ex)
        {
            SetAlert($"Error deleting book: {ex.Message}", true);
        }
    }

    private async Task ReserveBook(Guid bookId)
    {
        try
        {
            // Default user ID for demonstration
            var userId = Guid.Parse("00000000-0000-0000-0000-000000000001");
            var response = await Http.PostAsJsonAsync("api/reservations", new { BookId = bookId, UserId = userId });
            if (response.IsSuccessStatusCode)
            {
                SetAlert("Reservation requested successfully!", false);
            }
            else
            {
                var content = await response.Content.ReadAsStringAsync();
                SetAlert($"Reservation note: {content}", true);
            }
        }
        catch (Exception ex)
        {
            SetAlert($"Error reserving book: {ex.Message}", true);
        }
    }

    private void SetAlert(string message, bool isError)
    {
        alertMessage = message;
        isErrorAlert = isError;
    }

    public class BookDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Author { get; set; } = string.Empty;
        public string ISBN { get; set; } = string.Empty;
        public string Publisher { get; set; } = string.Empty;
        public int YearPublished { get; set; }
        public int TotalCopies { get; set; }
        public int AvailableCopies { get; set; }
        public Guid BranchId { get; set; }
        public string BranchName { get; set; } = string.Empty;
    }

    public class BranchDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    public class BookFormModel
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Author { get; set; } = string.Empty;
        public string ISBN { get; set; } = string.Empty;
        public string Publisher { get; set; } = string.Empty;
        public int YearPublished { get; set; } = DateTime.Now.Year;
        public int TotalCopies { get; set; } = 1;
        public Guid BranchId { get; set; }
    }
}
